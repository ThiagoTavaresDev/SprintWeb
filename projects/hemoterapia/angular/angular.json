{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "sprint-hemoterapia": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/sprint-hemoterapia",
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "styles": [
              "src/styles.css"
            ]
          },
          "configurations": {
            "development": {
              "optimization": false,
              "sourceMap": true
            },
            "reference": {
              "optimization": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/app/exercises.ts",
                  "with": "src/app/exercises.reference.ts"
                },
                {
                  "replace": "src/app/oficina/oficina.ts",
                  "with": "src/app/oficina/oficina.reference.ts"
                },
                {
                  "replace": "src/app/oficina-full/oficina-full.ts",
                  "with": "src/app/oficina-full/oficina-full.reference.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json",
            "port": 4210
          },
          "configurations": {
            "development": {
              "buildTarget": "sprint-hemoterapia:build:development"
            },
            "reference": {
              "buildTarget": "sprint-hemoterapia:build:reference"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
